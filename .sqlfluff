[sqlfluff]
dialect = tsql

# Combinando tus reglas de identificadores, funciones, literales y seguridad de columnas
select_rules = L010,capitalisation.identifiers,capitalisation.functions,capitalisation.literals,references.consistent,aliasing.unused,ambiguous.column_references

[sqlfluff:rules:capitalisation.keywords]
capitalisation_policy = upper

[sqlfluff:rules:capitalisation.functions]
capitalisation_policy = upper

[sqlfluff:rules:capitalisation.literals]
capitalisation_policy = upper

[sqlfluff:rules:capitalisation.identifiers]
# Exige que el estilo de nombres de tablas/columnas sea consistente en todo el archivo
capitalisation_policy = consistent

[sqlfluff:indentation]
tab_space_size = 4
indent_unit = space
